          fillColor=#111111;fontColor=#FFFFFF;strokeColor=#FF9900;
          strokeWidth=2;fontSize=14;"
          vertex="1"
          parent="1">
          <mxGeometry x="40" y="40" width="220" height="240" as="geometry"/>
